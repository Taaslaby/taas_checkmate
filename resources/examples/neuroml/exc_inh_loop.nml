<neuroml xmlns="http://www.neuroml.org/schema/neuroml2" id="exc_inh_loop">
  <!-- Классический возбудительно-тормозный контур (E-I loop):
       exc → inh (быстрый возбуждающий синапс) и inh → exc (тормозная петля).
       exc[0] гонится сильным DC-импульсом в регулярный спайк ~22 Гц. -->
  <izhikevichCell id="rs" v0="-65mV" thresh="30mV" a="0.02" b="0.2" c="-65mV" d="8"/>

  <!-- Возбуждающий синапс: быстрый спад, реверс выше потенциала покоя. -->
  <expOneSynapse id="synExc" gbase="0.5nS" erev="0mV" tauDecay="2ms"/>
  <!-- Тормозный синапс: реверс у покоя — шунтирует, а не возбуждает. -->
  <expOneSynapse id="synInh" gbase="1.0nS" erev="-70mV" tauDecay="5ms"/>

  <!-- Постоянный ток 10 nA на 1000 мс → exc[0] спайкает регулярно. -->
  <pulseGenerator id="pg" delay="0ms" duration="1000ms" amplitude="10"/>

  <network id="net">
    <population id="exc" component="rs" size="2"/>
    <population id="inh" component="rs" size="2"/>

    <!-- exc → inh: 2 связи. -->
    <projection presynapticPopulation="exc" postsynapticPopulation="inh" synapse="synExc">
      <connection preCellId="../exc[0]" postCellId="../inh[0]"/>
      <connection preCellId="../exc[1]" postCellId="../inh[1]"/>
    </projection>
    <!-- inh → exc: 2 связи (обратная тормозная петля). Итого 4 синапса. -->
    <projection presynapticPopulation="inh" postsynapticPopulation="exc" synapse="synInh">
      <connection preCellId="../inh[0]" postCellId="../exc[1]"/>
      <connection preCellId="../inh[1]" postCellId="../exc[0]"/>
    </projection>

    <explicitInput target="exc[0]" input="pg"/>
  </network>

  <Simulation id="sim" length="1000ms" step="0.5ms"/>
</neuroml>
