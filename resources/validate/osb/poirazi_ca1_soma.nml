<?xml version="1.0" encoding="ISO-8859-1"?>
<neuroml xmlns="http://www.neuroml.org/schema/neuroml2" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.neuroml.org/schema/neuroml2 https://raw.github.com/NeuroML/NeuroML2/development/Schemas/NeuroML2/NeuroML_v2beta4.xsd" id="poirazi_ca1_soma">

  <!--
    CA1 pyramidal cell — REDUCED subset of the published Poirazi–Brannon–Mel
    (2003) model (Open Source Brain: Poirazi2003-CA1PyramidalCell, NeuroML2
    export).

    All parameters are verbatim from the published model:
      * soma morphology: segment 0 (d = 4.58 µm, L = 0.01 µm);
      * soma channelDensities (mS/cm²): na 7, kdr 1.4, leak_chan 5e-3,
        hs (Ih) 1.872e-2, km (M-current) 60;
      * biophysics: Cm = 1 µF/cm², Ra = 0.05 kΩ·cm, V0 = −70 mV, thresh 0 mV.

    Channels are the published `h`/`km`/`kdr`/`na_soma` files (see channels/):
    the Ih `hs` uses the custom LEMS ComponentTypes `Poirazi_h_tau`
    (piecewise double-exponential tau) + `Poirazi_h_ss`; the M-current `km`
    uses gateHHrates with HHExpLinearRate + q10ExpTemp.

    Omitted (honestly): the dendrites (5160 segments) with their
    GHK/Ca-dependent channels, and the Na `s` gate (no_inact=1 ⇒ s≡1 — see
    na_soma.channel.nml). Per-channel `q10Settings` is parsed but not yet
    applied by the engine; validation runs at 6.3 °C where the global Q10 = 1.
  -->

  <include href="channels/h.channel.nml"/>
  <include href="channels/km.channel.nml"/>
  <include href="channels/kdr.channel.nml"/>
  <include href="channels/na_soma.channel.nml"/>

  <morphology id="morph">
    <!-- Real soma: CA1Pyr[0].soma[0] (2 3D points → 1 segment). -->
    <segment id="0" name="Seg0_soma_0">
      <proximal x="2.497" y="-13.006" z="11.13" diameter="4.58"/>
      <distal x="2.497" y="-13.006" z="11.12" diameter="4.58"/>
    </segment>
    <segmentGroup id="soma_group"><member segment="0"/></segmentGroup>
  </morphology>

  <biophysicalProperties id="bp">
    <membraneProperties>
      <channelDensity id="leak_soma" ionChannel="leak_chan" condDensity="5e-3mS_per_cm2" segmentGroup="soma_group" erev="-70mV" ion="non_specific"/>
      <channelDensity id="na_soma" ionChannel="na" condDensity="7mS_per_cm2" segmentGroup="soma_group" erev="50mV" ion="na"/>
      <channelDensity id="kdr_soma" ionChannel="kdr" condDensity="1.4mS_per_cm2" segmentGroup="soma_group" erev="-77mV" ion="k"/>
      <channelDensity id="hs_soma" ionChannel="hs" condDensity="1.872e-2mS_per_cm2" segmentGroup="soma_group" erev="-10mV" ion="na"/>
      <channelDensity id="km_soma" ionChannel="km" condDensity="60mS_per_cm2" segmentGroup="soma_group" erev="-80mV" ion="k"/>
      <spikeThresh value="0mV"/>
      <initMembPotential value="-70.0mV"/>
      <specificCapacitance value="1uF_per_cm2"/>
    </membraneProperties>
    <intracellularProperties>
      <resistivity value="0.05kohm_cm"/>
    </intracellularProperties>
  </biophysicalProperties>

  <cell id="ca1" morphology="morph" biophysicalProperties="bp"/>

  <!-- Pulse: hyperpolarizing −1e-7 nA for 50 ms → Ih opens → sag; release →
       rebound. (Absolute nA: the real soma is a 4.58 µm disk, C ≈ 1.4e-15 F.) -->
  <pulseGenerator id="pg" delay="50ms" duration="50ms" amplitude="-1e-7"/>

  <network id="net">
    <population id="pop" component="ca1" size="1"/>
    <explicitInput target="pop[0]" input="pg"/>
  </network>

  <Simulation id="sim" length="150ms" step="0.025ms"/>
</neuroml>
